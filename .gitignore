# ============================================================
# .gitignore — Files Git should ignore (never commit these)
# ============================================================

# Python virtual environment — machine-specific, huge, unneeded
venv/
.venv/

# Python bytecode cache — regenerated automatically
__pycache__/
*.pyc

# Secret config — contains passwords. Absolutely never commit.
.env

# SQLite files (not used here, but common to ignore)
*.db

# Test cache — regenerated by pytest
.pytest_cache/

# IDE folders
.idea/
.vscode/